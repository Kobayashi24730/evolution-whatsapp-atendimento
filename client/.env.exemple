# Configuração do Banco de Dados (Prisma)
# Substitua pelos dados do seu banco MySQL/PostgreSQL/SQLite
DATABASE_URL="Sua url"

# Configuração do NextAuth
# NEXTAUTH_URL deve ser a URL base do seu app em desenvolvimento
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="Sua chave secreta para o next"
AUTH_SECRET="Sua chave secreta para o auth"

# Integração com Evolution API
EVOLUTION_API_URL="integração com a evolution api"
EVOLUTION_API_KEY="Sua chave secreta para o evolution api"

# Configurações de Ambiente
NODE_ENV="development"